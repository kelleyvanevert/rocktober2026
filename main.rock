-- cmd-enter        run the selection, or the block under the cursor
-- cmd-shift-enter  run everything
-- cmd-.            stop all sound
-- cmd-r            start/stop recording
-- cmd-s            save file

sample("kick.mp3").play

add(
  sample("kick.mp3").gain(-12db).fit(500ms).repeat(inf),
  sample("kick.mp3").gain(-6db).fit(200ms).repeat(inf),
)
  .reverb(sample("kick.mp3")).gain(.3).limit.play


sample("recordings/2026-09-25 Gong sound 2.m4a", 0:08:672, 0:09:252).gain(-6db).reverb("cathedral").play




-- silje sings
sample("recordings/2026-10-02 Silje 3.m4a", 0:06:500, 0:16:500).reverb("cathedral").play

sample("recordings/2026-10-02 Silje 3.m4a", 0:06:500, 0:07:500).slice(00:00:200, 00:00:300)
  .repeat(inf).reverb("cathedral").play

-- dramatic percussion
sample("recordings/2026-09-25 Gong sound 2.m4a", 0:08:672, 0:08:971).fit(150ms).gain(-15db).repeat(inf).reverb("cathedral").play

sample("recordings/2026-08-31 Airplane bark.m4a", 0:8, 0:9).gain(-6db).repeat(inf).play

-- spanish speaking train conductor
sample("recordings/2026-07-23 Spanish speaking train conductor 2.m4a").gain(-6db).play

-- oh i can't do it
sample("recordings/2026-10-02 Silje 2.m4a", 0:59, 1:01).reverb("dark_room").play

-- does the sibling die?
sample("recordings/2026-10-02 Silje 2.m4a", 1:10:688, 1:15:500).reverb("dark_room").play

-- kicks
sample("kick.mp3").fit(500ms).repeat(inf).play

-- xiao dong
sample("recordings/2026-08-29 Big dinner.m4a", 0:11:190, 0:12:500).play

