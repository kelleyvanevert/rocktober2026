  sample("recordings/2026-07-23 Spanish speaking train conductor 2.m4a", 0:05:250, 0:06:125).gain(-6db),
  sample("recordings/2026-05-19 Noa, Carlota.m4a", 1:27:938, 1:30).gain(1.7),
  sample("recordings/2026-08-29 Big dinner.m4a", 0:11:190, 0:12:500)
).reverb("bright_room").play

