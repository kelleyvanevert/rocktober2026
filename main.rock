-- cmd-enter       run the selection, or the block under the cursor
-- cmd-shift-enter run everything
-- cmd-.           stop all sound

sample("kick.mp3").fit(500ms).play

seq(
  sample("kick.mp3").fit(250ms),
  sample("kick.mp3").fit(125ms).repeat(2),
).repeat(2).play

add(
  sample("kick.mp3").gain(-12db).fit(500ms).repeat(4),
  sample("kick.mp3").gain(-6db).fit(500ms).repeat(4),
).limit.play
